# Quire PDF. The apps live in macos/ and ios/, each with a project generated
# from its project.yml by xcodegen; what they share is the QuireKit package.
#
#   make ci     everything this machine can check
.DEFAULT_GOAL := help

# The simulator the iOS tests run on. Override for another device:
#   make ios IOS_SIMULATOR="iPad Pro 11-inch (M5)"
IOS_SIMULATOR ?= iPhone 17
IOS_DESTINATION = platform=iOS Simulator,name=$(IOS_SIMULATOR)

.PHONY: help
help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

.PHONY: ci
ci: ci-version ci-encryption kit macos ios ## Everything checkable on this machine

.PHONY: ci-version
ci-version: ## The version derivation, which the app test suites cannot reach
	@./scripts/version.test.sh

.PHONY: ci-encryption
ci-encryption: ## The encryption check, against code with encryption planted in it
	@./ios/Tools/check-encryption.test.sh

.PHONY: encryption-check
encryption-check: ## Check the iOS export-compliance declaration against the code
	@./ios/Tools/check-encryption.sh

.PHONY: kit
kit: ## Test QuireKit, the shared model, on macOS and in the iOS Simulator
	cd QuireKit && swift test
	@# The same tests on iOS, where compression takes a different path.
	cd QuireKit && xcodebuild test -scheme QuireKit -destination '$(IOS_DESTINATION)' -quiet

.PHONY: icon
icon: ## Export every icon from branding/logo.svg (needs Chrome)
	./branding/export.sh

.PHONY: projects
projects: macos-project ios-project ## Regenerate both Xcode projects

.PHONY: macos-project
macos-project: ## Regenerate the Xcode project from macos/project.yml
	cd macos && xcodegen generate

.PHONY: ios-project
ios-project: ## Regenerate the Xcode project from ios/project.yml
	cd ios && xcodegen generate

.PHONY: version
version: ## Stamp the marketing version and build number into both apps
	@# Two different numbers. The marketing version is derived from VERSION and
	@# the history, and its patch resets when the minor is bumped. The build
	@# number is the total commit count and must never reset: the App Store
	@# refuses an upload whose build number does not exceed the last one.
	@# Each step must stop the recipe on failure: without the `&&`s a failed
	@# version.sh still writes the file, with an empty MARKETING_VERSION that
	@# overrides Base.xcconfig's fallback and exits 0.
	@version="$$(./scripts/version.sh)" && \
	  build="$$(git rev-list --count HEAD)" && \
	  for app in macos ios; do \
	    printf '// Generated by `make version`. Do not edit or commit.\nMARKETING_VERSION = %s\nCURRENT_PROJECT_VERSION = %s\n' \
	      "$$version" "$$build" > $$app/Config/Version.xcconfig || exit 1; \
	  done && \
	  echo "version: $$version   build: $$build   (macos, ios)"

.PHONY: macos-version
macos-version: version ## Same as `make version`, kept for existing habits

.PHONY: macos
macos: ## Build the macOS app
	cd macos && xcodebuild -project QuirePDF.xcodeproj -scheme QuirePDF \
	  -destination 'platform=macOS' build -quiet

.PHONY: screenshots
screenshots: ## Capture App Store screenshots for every required display
	./ios/Tools/screenshots.sh

.PHONY: ios
ios: encryption-check ## Build the iOS app and run its UI tests in the Simulator
	cd ios && xcodebuild -project QuirePDF.xcodeproj -scheme QuirePDF \
	  -destination '$(IOS_DESTINATION)' test -quiet
